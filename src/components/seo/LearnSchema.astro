---
/**
 * LearnSchema - JSON-LD structured data for learn pages
 * Improves SEO and enables rich results in search engines
 */

interface PretestQuestion {
  questionText: string;
  correctAnswer: string;
}

interface Props {
  title: string;
  description: string;
  category: string;
  subcategory?: string;
  difficulty?: string;
  slug: string;
  /** ISO 8601 datetime — when the article was first published. */
  datePublished?: string;
  /** ISO 8601 datetime — when the article was last meaningfully updated. */
  dateModified?: string;
  /** Number of pretest questions available for this article. */
  pretestQuestionCount?: number;
  /** Pretest question data for schema serialisation. */
  pretestQuestions?: PretestQuestion[];
}

const {
  title,
  description,
  category,
  subcategory,
  difficulty,
  slug,
  datePublished,
  dateModified,
  pretestQuestionCount = 0,
  pretestQuestions = [],
} = Astro.props;

const url = `https://gemmology.dev/learn/${slug}`;

// Helper to format category names
function formatName(name: string): string {
  return name
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

// Build hasPart Quiz node when pretest questions are available
const quizNode = pretestQuestionCount > 0
  ? {
      "@type": "Quiz",
      "name": `Pretest: ${title}`,
      "educationalLevel": "Intermediate",
      "numberOfQuestions": pretestQuestionCount,
      "about": { "@type": "Thing", "name": title },
      "hasPart": pretestQuestions.map(q => ({
        "@type": "Question",
        "name": q.questionText,
        "acceptedAnswer": { "@type": "Answer", "text": q.correctAnswer },
      })),
    }
  : null;

// Use combined LearningResource + Article so Google can pick either rich-result type
const articleSchema = {
  "@context": "https://schema.org",
  "@type": ["LearningResource", "Article"],
  "headline": title,
  "name": title,
  "description": description,
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "author": {
    "@type": "Organization",
    "name": "gemmology.dev",
    "url": "https://gemmology.dev"
  },
  "publisher": {
    "@type": "Organization",
    "name": "gemmology.dev",
    "url": "https://gemmology.dev",
    "logo": {
      "@type": "ImageObject",
      "url": "https://gemmology.dev/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": url
  },
  "educationalLevel": difficulty || "intermediate",
  "learningResourceType": "Article",
  "teaches": formatName(category),
  "about": {
    "@type": "Thing",
    "name": formatName(category)
  },
  ...(datePublished ? { "datePublished": datePublished } : {}),
  ...(dateModified ? { "dateModified": dateModified } : {}),
  ...(quizNode ? { "hasPart": quizNode } : {}),
};

// Build BreadcrumbList — no fragment URLs (Google rejects them).
// Chain: Home → Learn → [subcategory overview if present →] Article
const breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://gemmology.dev" },
  { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://gemmology.dev/learn" },
];

if (subcategory) {
  // Position 3: article page (subcategory is visible-only; no clean URL to use here)
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 3,
    "name": formatName(subcategory),
    "item": url,
  });
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 4,
    "name": title,
    "item": url,
  });
} else {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 3,
    "name": title,
    "item": url,
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};
---

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
