---
/**
 * StructuredData - emit a BreadcrumbList, optional WebPage, and optional Person JSON-LD.
 * Use for non-mineral / non-learn pages that still benefit from breadcrumbs.
 */

interface Crumb {
  name: string;
  url: string;
}

interface PersonData {
  name: string;
  jobTitle?: string;
  credentials?: string[];
  sameAs?: string[];
}

interface Props {
  breadcrumbs?: Crumb[];
  webPage?: {
    name: string;
    description?: string;
    url: string;
  };
  /**
   * Optional Person JSON-LD — used on /about to signal E-E-A-T authorship.
   */
  person?: PersonData;
}

const { breadcrumbs = [], webPage, person } = Astro.props;

const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    }
  : null;

const webPageSchema = webPage
  ? {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: webPage.name,
      description: webPage.description,
      url: webPage.url,
      inLanguage: "en",
      isPartOf: {
        "@type": "WebSite",
        name: "gemmology.dev",
        url: "https://gemmology.dev",
      },
    }
  : null;

const personSchema = person
  ? {
      "@context": "https://schema.org",
      "@type": "Person",
      name: person.name,
      ...(person.jobTitle ? { jobTitle: person.jobTitle } : {}),
      knowsAbout: [
        "Gemmology",
        "Mineralogy",
        "Crystallography",
        "Gemstone identification",
      ],
      ...(person.credentials && person.credentials.length > 0
        ? {
            hasCredential: person.credentials.map((c) => ({
              "@type": "EducationalOccupationalCredential",
              credentialCategory: "certificate",
              name: c,
            })),
          }
        : {}),
      ...(person.sameAs && person.sameAs.length > 0
        ? { sameAs: person.sameAs }
        : {}),
      worksFor: {
        "@type": "Organization",
        name: "gemmology.dev",
        url: "https://gemmology.dev",
      },
    }
  : null;
---

{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
{webPageSchema && <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />}
{personSchema && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
