---
/**
 * StructuredData - emit a BreadcrumbList plus optional WebPage JSON-LD.
 * Use for non-mineral / non-learn pages that still benefit from breadcrumbs.
 */

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  breadcrumbs?: Crumb[];
  webPage?: {
    name: string;
    description?: string;
    url: string;
  };
}

const { breadcrumbs = [], webPage } = Astro.props;

const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    }
  : null;

const webPageSchema = webPage
  ? {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: webPage.name,
      description: webPage.description,
      url: webPage.url,
      inLanguage: "en",
      isPartOf: {
        "@type": "WebSite",
        name: "gemmology.dev",
        url: "https://gemmology.dev",
      },
    }
  : null;
---

{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
{webPageSchema && <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />}
