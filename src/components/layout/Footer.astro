---
import { PLAYGROUND_ENABLED } from '../../lib/feature-flags';

const links = {
  product: [
    { href: '/gallery', label: 'Crystal Gallery' },
    ...(PLAYGROUND_ENABLED ? [{ href: '/playground', label: 'CDL Playground' }] : []),
    { href: '/learn', label: 'Learn' },
    { href: '/quiz', label: 'Quiz & Exams' },
    { href: '/tools', label: 'Tools & Calculators' },
    { href: '/docs', label: 'Documentation' },
  ],
  developers: [
    { href: 'https://pypi.org/project/cdl-parser/', label: 'cdl-parser' },
    { href: 'https://pypi.org/project/crystal-geometry/', label: 'crystal-geometry' },
    { href: 'https://pypi.org/project/mineral-database/', label: 'mineral-database' },
    { href: 'https://pypi.org/project/crystal-renderer/', label: 'crystal-renderer' },
  ],
  resources: [
    { href: '/docs/cdl', label: 'CDL Specification' },
    { href: '/docs/api/cdl-parser', label: 'API Reference' },
    { href: '/docs/cli', label: 'CLI Reference' },
    { href: 'https://github.com/gemmology-dev', label: 'GitHub' },
  ],
};

const currentYear = new Date().getFullYear();

// "Packages" lists the PyPI distributions and is only relevant to developers
// reading the docs. On consumer surfaces (quiz, learn, tools, gallery, home,
// minerals) the column is noise and gets hidden — see P2-9.
const path = Astro.url.pathname;
const showPackages = path.startsWith('/docs');
---

<!--
  Dark mode: this footer is the SINGLE deliberate "cream inverse band" usage in the
  whole site (per token-spec.md) - a jewlarray.ch-style echo where, in dark mode only,
  the footer flips to a light cream surface (cream-inverse) with dark coffee-ink text,
  rather than following the coffee-raised/cream-text pattern used everywhere else.
  Do not replicate this inversion elsewhere.
-->
<footer class="border-t border-slate-200 bg-slate-50 dark:border-cream-inverse dark:bg-cream-inverse">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class:list={['grid grid-cols-2 gap-8', showPackages ? 'md:grid-cols-4' : 'md:grid-cols-3']}>
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 text-slate-900 font-semibold dark:text-coffee-sunk">
          <svg class="h-6 w-6 text-crystal-700" viewBox="0 0 32 32" fill="none">
            <path d="M16 2L28 10V22L16 30L4 22V10L16 2Z" stroke="currentColor" stroke-width="2" fill="none"/>
            <path d="M16 2L16 30" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
            <path d="M4 10L28 22" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
            <path d="M28 10L4 22" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
          </svg>
          gemmology.dev
        </a>
        <p class="mt-3 text-sm text-slate-600 dark:text-coffee-border-strong">
          Crystal structure visualisation and gemmological reference for FGA students and professionals.
        </p>
      </div>

      <!-- Product -->
      <div>
        <h3 class="font-semibold text-slate-900 text-sm dark:text-coffee-sunk">Product</h3>
        <ul class="mt-4 space-y-2">
          {links.product.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-slate-600 hover:text-slate-900 transition-colors dark:text-coffee-border-strong dark:hover:text-coffee-sunk">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Developers (only on /docs/* — see P2-9) -->
      {showPackages && (
        <div>
          <h3 class="font-semibold text-slate-900 text-sm dark:text-coffee-sunk">Packages</h3>
          <ul class="mt-4 space-y-2">
            {links.developers.map(({ href, label }) => (
              <li>
                <a href={href} target="_blank" rel="noopener noreferrer" class="text-sm text-slate-600 hover:text-slate-900 transition-colors dark:text-coffee-border-strong dark:hover:text-coffee-sunk">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Resources -->
      <div>
        <h3 class="font-semibold text-slate-900 text-sm dark:text-coffee-sunk">Resources</h3>
        <ul class="mt-4 space-y-2">
          {links.resources.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-slate-600 hover:text-slate-900 transition-colors dark:text-coffee-border-strong dark:hover:text-coffee-sunk">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4 dark:border-coffee-sunk/10">
      <p class="text-sm text-slate-600 dark:text-coffee-border-strong">
        &copy; {currentYear} gemmology.dev. Code under <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer" class="hover:text-slate-700 dark:hover:text-coffee-sunk">MIT</a>, content under <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-700 dark:hover:text-coffee-sunk">CC BY-SA 4.0</a>.
      </p>
      <p class="text-sm text-slate-600 dark:text-coffee-border-strong">
        Built for the <a href="https://gem-a.com" target="_blank" rel="noopener noreferrer" class="text-crystal-700 underline underline-offset-2 hover:text-crystal-800">FGA</a> community
      </p>
    </div>
  </div>
</footer>
