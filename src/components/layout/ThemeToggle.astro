---
/**
 * ThemeToggle - framework-free dark mode switch.
 *
 * Reflects/drives the `data-theme` attribute set by the no-FOUC script in
 * BaseLayout.astro (the single source of truth for theme state - see
 * docs/dark-mode.md). This component may be rendered more than once per page
 * (desktop header + mobile menu); all instances stay in sync via the
 * `.theme-toggle` class + a document-level `themechange` event, not per-id
 * wiring.
 *
 * - Instant theme switch (no global color transition).
 * - A subtle 150ms crossfade on the icon only, disabled under
 *   prefers-reduced-motion.
 * - aria-pressed mirrors the current theme; aria-label is static per spec.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  type="button"
  class:list={[
    'theme-toggle',
    'inline-flex items-center justify-center rounded-lg p-2',
    'text-slate-600 hover:text-slate-900 dark:text-cream-secondary dark:hover:text-cream-primary',
    'transition-colors',
    'focus:outline-none focus-visible:ring-2 focus-visible:ring-crystal-500 focus-visible:ring-offset-2 dark:focus-visible:ring-crystal-400',
    className,
  ]}
  aria-label="Toggle dark mode"
  aria-pressed="false"
>
  <span class="theme-toggle-icons relative inline-flex h-5 w-5">
    <!-- Sun: shown in light mode -->
    <svg
      class="theme-toggle-icon theme-toggle-icon--sun absolute inset-0 h-5 w-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M12 3v1.5m0 15V21m9-9h-1.5m-15 0H3m15.364-6.364l-1.06 1.06M6.696 17.304l-1.06 1.06m0-12.728l1.06 1.06M17.304 17.304l1.06 1.06M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"
      />
    </svg>
    <!-- Moon: shown in dark mode -->
    <svg
      class="theme-toggle-icon theme-toggle-icon--moon absolute inset-0 h-5 w-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21.752 15.002A9.72 9.72 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 008.997-5.998z"
      />
    </svg>
  </span>
</button>

<style>
  .theme-toggle-icon--sun {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  .theme-toggle-icon--moon {
    opacity: 0;
    transform: scale(0.7) rotate(-30deg);
  }

  :global([data-theme='dark']) .theme-toggle-icon--sun {
    opacity: 0;
    transform: scale(0.7) rotate(30deg);
  }

  :global([data-theme='dark']) .theme-toggle-icon--moon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  .theme-toggle-icon {
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle-icon {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    function isDark() {
      return document.documentElement.getAttribute('data-theme') === 'dark';
    }

    function sync() {
      var pressed = String(isDark());
      document.querySelectorAll('.theme-toggle').forEach(function (btn) {
        btn.setAttribute('aria-pressed', pressed);
      });
    }

    // Bind the shared listeners exactly once per page, no matter how many
    // ThemeToggle instances are rendered.
    if (!window.__themeToggleBound) {
      window.__themeToggleBound = true;

      document.addEventListener('click', function (event) {
        var btn = event.target.closest ? event.target.closest('.theme-toggle') : null;
        if (!btn) return;
        var next = isDark() ? 'light' : 'dark';
        if (window.__setTheme) {
          window.__setTheme(next);
        } else {
          // Defensive fallback if BaseLayout's script did not run for some
          // reason - should not happen in normal operation.
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        }
        sync();
      });

      document.addEventListener('themechange', sync);
    }

    // Sync whichever toggle buttons exist at the time this instance's script
    // runs (covers late-appearing instances, e.g. the mobile menu).
    sync();
  })();
</script>
