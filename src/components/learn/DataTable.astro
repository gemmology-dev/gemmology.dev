---
/**
 * DataTable - Displays tabular data.
 * Updated to use consistent styling with Astro UI.
 * Accepts an optional citationIndex prop; cells containing {cite:id} markers
 * are rendered via set:html after marker resolution. All other cells remain
 * plain text nodes to avoid any XSS risk.
 */
import { resolveCiteMarkers, type CitationIndex } from '../../lib/citations/index';

interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
  citationIndex?: CitationIndex;
}

const { headers, rows, caption, citationIndex } = Astro.props;

// Process cell: only resolve if the cell actually contains a marker.
function processCellHtml(cell: string): string {
  if (!citationIndex || !/\{cite:/.test(cell)) return cell;
  return resolveCiteMarkers(cell, citationIndex);
}
---

<div class="overflow-x-auto my-6 rounded-xl border border-slate-200">
  {caption && (
    <div class="text-sm text-slate-600 px-4 py-2 text-left bg-slate-50 border-b border-slate-200">{caption}</div>
  )}
  <table class="min-w-full divide-y divide-slate-200 !m-0">
    <thead class="bg-gradient-to-r from-crystal-50 to-slate-50">
      <tr>
        {headers.map(header => (
          <th class="px-4 py-3 text-left text-xs font-semibold text-slate-700 uppercase tracking-wider border-b border-slate-200">
            {header}
          </th>
        ))}
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-slate-100">
      {rows.map(row => (
        <tr class="hover:bg-slate-50 transition-colors">
          {row.map((cell, i) => {
            const hasCite = citationIndex && /\{cite:/.test(cell);
            return (
              <td class={`px-4 py-3 text-sm ${i === 0 ? 'font-medium text-slate-900' : 'text-slate-600'}`}>
                {hasCite
                  ? <Fragment set:html={processCellHtml(cell)} />
                  : cell}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
