---
/**
 * ComparisonBlock - Displays side-by-side comparisons
 * Updated to use Astro UI Card component
 */
import Card from '../ui-astro/Card.astro';

interface ComparisonItem {
  title: string;
  points: string[];
  variant?: 'default' | 'success' | 'warning' | 'danger';
}

interface Props {
  items: ComparisonItem[];
  headingLevel?: 3 | 4;
}

const { items, headingLevel = 3 } = Astro.props;
const HeadingTag = `h${headingLevel}` as 'h3' | 'h4';

// Dark variants follow the alpha-tint pattern (bg-{hue}-400/10, border-{hue}-400/20)
// used site-wide for badge/chip/callout surfaces (see docs/dark-mode.md).
const variantClasses = {
  default: 'bg-slate-50 border-slate-200 dark:bg-coffee-raised dark:border-coffee-border',
  success: 'bg-emerald-50 border-emerald-200 dark:bg-emerald-400/10 dark:border-emerald-400/20',
  warning: 'bg-amber-50 border-amber-200 dark:bg-amber-400/10 dark:border-amber-400/20',
  danger: 'bg-red-50 border-red-200 dark:bg-red-400/10 dark:border-red-400/20',
};

const titleClasses = {
  default: 'text-slate-900 dark:text-cream-primary',
  success: 'text-emerald-900 dark:text-emerald-300',
  warning: 'text-amber-900 dark:text-amber-300',
  danger: 'text-red-900 dark:text-red-300',
};

const textClasses = {
  default: 'text-slate-600 dark:text-cream-secondary',
  success: 'text-emerald-800 dark:text-emerald-300/90',
  warning: 'text-amber-800 dark:text-amber-300/90',
  danger: 'text-red-800 dark:text-red-300/90',
};

const gridCols = items.length === 2
  ? 'sm:grid-cols-2'
  : items.length === 3
    ? 'sm:grid-cols-3'
    : 'sm:grid-cols-2 lg:grid-cols-4';
---

<div class={`grid gap-6 my-8 ${gridCols}`}>
  {items.map(item => {
    const variant = item.variant || 'default';
    return (
      <Card padding="md" class={variantClasses[variant]}>
        <HeadingTag class={`font-semibold ${titleClasses[variant]}`}>{item.title}</HeadingTag>
        <ul class={`mt-3 text-sm ${textClasses[variant]}`}>
          {item.points.map((point, i) => (
            <li class={`py-2 ${i < item.points.length - 1 ? 'border-b border-current/10' : ''}`}>
              {point}
            </li>
          ))}
        </ul>
      </Card>
    );
  })}
</div>
