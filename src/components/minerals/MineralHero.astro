---
/**
 * MineralHero - Hero section for mineral detail pages
 * Shows name, chemistry, system badge, and crystal preview
 */
import type { Mineral } from '../../lib/db';
import { Badge } from '../ui/Badge';
import { cleanCrystalSvg, isValidSvg } from '../../lib/svg-utils';

interface Props {
  mineral: Mineral;
}

const { mineral } = Astro.props;

// Use SVG from database if available, otherwise fallback to file path
const hasSvgContent = isValidSvg(mineral.model_svg);
const cleanedSvg = hasSvgContent ? cleanCrystalSvg(mineral.model_svg!) : '';
const svgPath = `/crystals/${mineral.id}.svg`;

// System colors
const systemColors: Record<string, string> = {
  cubic: 'bg-purple-100 text-purple-800 dark:bg-purple-400/10 dark:text-purple-300 dark:border dark:border-purple-400/20',
  hexagonal: 'bg-blue-100 text-blue-800 dark:bg-blue-400/10 dark:text-blue-300 dark:border dark:border-blue-400/20',
  trigonal: 'bg-cyan-100 text-cyan-800 dark:bg-cyan-400/10 dark:text-cyan-300 dark:border dark:border-cyan-400/20',
  tetragonal: 'bg-green-100 text-green-800 dark:bg-green-400/10 dark:text-green-300 dark:border dark:border-green-400/20',
  orthorhombic: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-400/10 dark:text-yellow-300 dark:border dark:border-yellow-400/20',
  monoclinic: 'bg-orange-100 text-orange-800 dark:bg-orange-400/10 dark:text-orange-300 dark:border dark:border-orange-400/20',
  triclinic: 'bg-red-100 text-red-800 dark:bg-red-400/10 dark:text-red-300 dark:border dark:border-red-400/20',
  amorphous: 'bg-rose-100 text-rose-800 dark:bg-rose-400/10 dark:text-rose-300 dark:border dark:border-rose-400/20',
};

const systemColor = systemColors[mineral.system?.toLowerCase()] || 'bg-slate-100 text-slate-800 dark:bg-coffee-raised2 dark:text-cream-secondary dark:border dark:border-coffee-border-strong';

// Acronym title-casing — keep known initialisms uppercase rather than letting
// CSS `capitalize`/JS title-case mangle them (P2-7).
const ACRONYMS = new Set(['CVD', 'HPHT', 'FTIR', 'HPLC', 'GIA', 'FGA', 'AGTA', 'EDXRF', 'XRF', 'EDS', 'SEM', 'UV', 'IR', 'NIR', 'YAG', 'GGG', 'CZ']);
function formatLabel(value: string | null | undefined): string {
  if (!value) return '';
  return value
    .replace(/_/g, ' ')
    .split(' ')
    .map(word => {
      const upper = word.toUpperCase();
      if (ACRONYMS.has(upper)) return upper;
      return word.charAt(0).toUpperCase() + word.slice(1);
    })
    .join(' ');
}
---

<div class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200 dark:from-coffee-raised dark:to-coffee-page dark:border-coffee-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8 lg:pt-10">
    <!-- Breadcrumb (above H1 — P2-15) -->
    <nav class="text-sm text-slate-600 dark:text-cream-secondary" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center">
        <li><a href="/" class="hover:text-crystal-700 dark:hover:text-crystal-400">Home</a></li>
        <li aria-hidden="true" class="mx-2">/</li>
        <li><a href="/gallery" class="hover:text-crystal-700 dark:hover:text-crystal-400">Gallery</a></li>
        <li aria-hidden="true" class="mx-2">/</li>
        <li><span class="text-slate-700 dark:text-cream-primary" aria-current="page">{mineral.name}</span></li>
      </ol>
    </nav>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 lg:pb-16 pt-6 lg:pt-8">
    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
      <!-- Crystal SVG Preview — permanent light "specimen plate", see docs/dark-mode.md -->
      <div class="w-48 h-48 lg:w-64 lg:h-64 flex-shrink-0">
        <div class="w-full h-full bg-white rounded-2xl shadow-lg p-4 flex items-center justify-center dark:border dark:border-coffee-border">
          {hasSvgContent ? (
            <div
              class="w-full h-full [&>svg]:w-full [&>svg]:h-full [&>svg]:max-w-full [&>svg]:max-h-full"
              set:html={cleanedSvg}
            />
          ) : (
            <img
              src={svgPath}
              alt={`${mineral.name} crystal structure`}
              class="max-w-full max-h-full object-contain"
              loading="eager"
              onerror="this.src='/crystals/placeholder.svg'"
            />
          )}
        </div>
      </div>

      <!-- Mineral Info -->
      <div class="flex-1 text-center lg:text-left">
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 mb-4">
          <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${systemColor}`}>
            {mineral.system}
          </span>
          {mineral.origin && mineral.origin !== 'natural' && (
            <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${
              mineral.origin === 'synthetic' ? 'bg-blue-100 text-blue-800 dark:bg-blue-400/10 dark:text-blue-300 dark:border dark:border-blue-400/20' :
              mineral.origin === 'simulant' ? 'bg-amber-100 text-amber-800 dark:bg-amber-400/10 dark:text-amber-300 dark:border dark:border-amber-400/20' :
              mineral.origin === 'composite' ? 'bg-slate-200 text-slate-700 dark:bg-coffee-raised2 dark:text-cream-secondary dark:border dark:border-coffee-border-strong' :
              'bg-slate-100 text-slate-700 dark:bg-coffee-raised2 dark:text-cream-secondary dark:border dark:border-coffee-border-strong'
            }`}>
              {formatLabel(mineral.origin)}
            </span>
          )}
          {mineral.category && (
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-slate-100 text-slate-700 dark:bg-coffee-raised2 dark:text-cream-secondary dark:border dark:border-coffee-border-strong">
              {mineral.category}
            </span>
          )}
        </div>

        <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-3 dark:text-cream-primary">
          {mineral.name}
        </h1>

        {mineral.chemistry && (
          <p class="text-xl text-slate-600 font-mono mb-4 dark:text-cream-secondary">
            {mineral.chemistry}
          </p>
        )}
      </div>
    </div>
  </div>
</div>
