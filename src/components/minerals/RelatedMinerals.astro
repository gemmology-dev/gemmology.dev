---
/**
 * RelatedMinerals - Shows minerals from the same crystal system
 */
import type { Mineral } from '../../lib/db';
import { cleanCrystalSvg, isValidSvg } from '../../lib/svg-utils';

interface Props {
  minerals: Mineral[];
  currentSystem: string;
}

const { minerals, currentSystem } = Astro.props;
---

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden dark:bg-coffee-raised dark:border-coffee-border">
  <div class="px-6 py-4 border-b border-slate-100 dark:border-coffee-border">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-cream-primary">Related Minerals</h2>
    <p class="text-sm text-slate-600 mt-1 dark:text-cream-secondary">
      Other minerals in the {currentSystem} system
    </p>
  </div>

  <div class="divide-y divide-slate-100 dark:divide-coffee-border">
    {minerals.map((mineral) => {
      // Use mineral.id for both URL and SVG path (matches preset IDs)
      const svgPath = `/crystals/${mineral.id}.svg`;
      const hasSvg = isValidSvg(mineral.model_svg);
      const cleanedSvg = hasSvg ? cleanCrystalSvg(mineral.model_svg!) : '';

      return (
        <a
          href={`/minerals/${mineral.id}`}
          class="flex items-center gap-4 p-4 hover:bg-slate-50 transition-colors dark:hover:bg-coffee-raised2"
        >
          <div class="w-12 h-12 flex-shrink-0 bg-slate-50 rounded-lg p-1 overflow-hidden dark:border dark:border-coffee-border">
            {hasSvg ? (
              <div
                class="w-full h-full [&>svg]:w-full [&>svg]:h-full [&>svg]:max-w-full [&>svg]:max-h-full"
                set:html={cleanedSvg}
              />
            ) : (
              <img
                src={svgPath}
                alt={mineral.name}
                class="w-full h-full object-contain"
                loading="lazy"
                onerror="this.src='/crystals/placeholder.svg'"
              />
            )}
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-medium text-slate-900 truncate dark:text-cream-primary">{mineral.name}</div>
            {mineral.chemistry && (
              <div class="text-sm text-slate-600 font-mono truncate dark:text-cream-secondary">{mineral.chemistry}</div>
            )}
          </div>
          <svg class="w-5 h-5 text-slate-500 flex-shrink-0 dark:text-cream-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      );
    })}
  </div>

  <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 dark:bg-coffee-raised2 dark:border-coffee-border">
    <a
      href={`/gallery?system=${currentSystem.toLowerCase()}`}
      class="text-sm text-sky-600 hover:text-sky-700 font-medium dark:text-sky-400 dark:hover:text-sky-300"
    >
      View all {currentSystem} minerals <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>
