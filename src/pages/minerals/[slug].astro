---
/**
 * Individual Mineral Detail Page
 * Generated statically for all 96+ minerals in the database
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MineralHero from '../../components/minerals/MineralHero.astro';
import QuickFacts from '../../components/minerals/QuickFacts.astro';
import PropertyTable from '../../components/minerals/PropertyTable.astro';
import CrystalStructureCard from '../../components/minerals/CrystalStructureCard.astro';
import RelatedMinerals from '../../components/minerals/RelatedMinerals.astro';
import CounterpartsSection from '../../components/minerals/CounterpartsSection.astro';
import PlaygroundLink from '../../components/minerals/PlaygroundLink.astro';
import LearnMoreSection from '../../components/minerals/LearnMoreSection.astro';
import TagList from '../../components/minerals/TagList.astro';
import MineralSchema from '../../components/seo/MineralSchema.astro';
import { getAllMinerals, getAllFamilies, getPrimaryExpressionId, getMineralWithModels, getMineralsBySystemWithSvg, getCounterpartMinerals, getNaturalCounterpart, type Mineral } from '../../lib/db-server';

export async function getStaticPaths() {
  const minerals = await getAllMinerals();

  // Fetch full mineral data with models for each mineral
  const mineralsWithModels = await Promise.all(
    minerals.map(async (mineral) => {
      const fullMineral = await getMineralWithModels(mineral.name);
      return fullMineral || mineral;
    })
  );

  // Index by expression ID for fast lookup
  const byId = new Map(mineralsWithModels.map((m) => [m.id, m]));

  // Build paths for each expression (e.g., /minerals/pearl-nacre)
  const paths = mineralsWithModels.map((mineral) => ({
    params: { slug: mineral.id },
    props: { mineral },
  }));

  // Also generate family-level pages (e.g., /minerals/pearl) that show the
  // primary expression. This ensures gallery links (which use family IDs) work.
  const families = await getAllFamilies();
  for (const family of families) {
    if (!byId.has(family.id)) {
      const primaryId = await getPrimaryExpressionId(family.id);
      const primary = primaryId ? byId.get(primaryId) : undefined;
      if (primary) {
        paths.push({
          params: { slug: family.id },
          props: { mineral: primary },
        });
      }
    }
  }

  return paths;
}

interface Props {
  mineral: Mineral;
}

const { mineral } = Astro.props;

// Get related minerals from the same crystal system (with SVG for thumbnails)
const relatedMinerals = (await getMineralsBySystemWithSvg(mineral.system))
  .filter((m) => m.id !== mineral.id)
  .slice(0, 6);

// Get counterpart minerals (synthetics/simulants for natural, or natural for synthetic/simulant)
const isNatural = !mineral.origin || mineral.origin === 'natural';
const counterparts = isNatural ? await getCounterpartMinerals(mineral.id) : [];
const naturalCounterpart = !isNatural && mineral.natural_counterpart_id
  ? await getNaturalCounterpart(mineral.natural_counterpart_id)
  : null;

// Generate page metadata
const title = `${mineral.name} Crystal Structure`;
const description = `Explore the ${mineral.name} crystal structure, properties, and CDL notation. ${mineral.system} system${mineral.chemistry ? `, ${mineral.chemistry}` : ''}.`;
const canonicalUrl = `https://gemmology.dev/minerals/${mineral.id}`;
---

<BaseLayout title={title} description={description}>
  <MineralSchema mineral={mineral} slot="head" />

  <main class="min-h-screen bg-slate-50">
    <!-- Hero Section -->
    <MineralHero mineral={mineral} />

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Left Column: Crystal Structure & Properties -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Quick Facts -->
          <QuickFacts mineral={mineral} />

          <!-- Mobile-only primary CTA (desktop renders in right column) -->
          <div class="lg:hidden">
            <PlaygroundLink mineral={mineral} />
          </div>

          <!-- Crystal Structure -->
          <CrystalStructureCard mineral={mineral} />

          <!-- Physical Properties -->
          <PropertyTable
            title="Physical Properties"
            properties={[
              { label: 'Crystal System', value: mineral.system },
              { label: 'Hardness (Mohs)', value: mineral.hardness },
              { label: 'Specific Gravity', value: mineral.sg },
              { label: 'Cleavage', value: mineral.cleavage },
              { label: 'Fracture', value: mineral.fracture },
              { label: 'Lustre', value: mineral.lustre },
              { label: 'Twin Law', value: mineral.twin_law },
            ]}
          />

          <!-- Optical Properties -->
          <PropertyTable
            title="Optical Properties"
            properties={[
              { label: 'Refractive Index', value: mineral.ri },
              { label: 'Birefringence', value: mineral.birefringence },
              { label: 'Optical Character', value: mineral.optical_character },
              { label: 'Dispersion', value: mineral.dispersion },
              { label: 'Pleochroism', value: mineral.pleochroism_strength
                ? `${mineral.pleochroism_strength.replace(/_/g, ' ')}${mineral.pleochroism_color1 ? ': ' + [mineral.pleochroism_color1, mineral.pleochroism_color2, mineral.pleochroism_color3].filter(Boolean).join(' / ') : ''}${mineral.pleochroism_notes ? ' (' + mineral.pleochroism_notes + ')' : ''}`
                : mineral.pleochroism },
              { label: 'Phenomenon', value: mineral.phenomenon?.replace(/_/g, ' ') },
              { label: 'Fluorescence', value: mineral.fluorescence },
            ]}
          />

          {/* Origin & Identification (for synthetics/simulants) */}
          {mineral.origin && mineral.origin !== 'natural' && (
            <PropertyTable
              title="Origin & Identification"
              properties={[
                { label: 'Origin', value: mineral.origin },
                { label: 'Growth Method', value: mineral.growth_method?.replace(/_/g, ' ') },
                { label: 'Manufacturer', value: mineral.manufacturer },
                { label: 'First Produced', value: mineral.year_first_produced },
                { label: 'Diagnostic Features', value: mineral.diagnostic_synthetic_features },
              ]}
            />
          )}

          {/* JSON array sections */}
          <TagList title="Colours" json={mineral.colors_json} colorClass="bg-sky-50 text-sky-700" />
          <TagList title="Localities" json={mineral.localities_json} colorClass="bg-emerald-50 text-emerald-700" />
          <TagList title="Common Inclusions" json={mineral.inclusions_json} colorClass="bg-amber-50 text-amber-700" />
          <TagList title="Known Treatments" json={mineral.treatments_json} colorClass="bg-rose-50 text-rose-700" />
          <TagList title="Crystal Forms" json={mineral.forms_json} colorClass="bg-violet-50 text-violet-700" />

          {/* Diagnostic Features (family-level) */}
          {mineral.diagnostic_features && (
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
              <div class="px-6 py-4 border-b border-slate-100">
                <h2 class="text-lg font-semibold text-slate-900">Diagnostic Features</h2>
              </div>
              <div class="px-6 py-4 text-slate-700">{mineral.diagnostic_features}</div>
            </div>
          )}

          {/* Notes */}
          {mineral.note && (
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
              <div class="px-6 py-4 border-b border-slate-100">
                <h2 class="text-lg font-semibold text-slate-900">Notes</h2>
              </div>
              <div class="px-6 py-4 text-slate-700">{mineral.note}</div>
            </div>
          )}
        </div>

        <!-- Right Column: Actions & Related -->
        <div class="space-y-8">
          <!-- Open in Playground (desktop only - mobile sees it above) -->
          <div class="hidden lg:block">
            <PlaygroundLink mineral={mineral} />
          </div>

          <!-- Synthetics & Simulants / Natural Counterpart -->
          <CounterpartsSection
            mineral={mineral}
            counterparts={counterparts}
            naturalCounterpart={naturalCounterpart}
          />

          <!-- Related Minerals -->
          {relatedMinerals.length > 0 && (
            <RelatedMinerals minerals={relatedMinerals} currentSystem={mineral.system} />
          )}
        </div>
      </div>

      <!-- Learn More Section -->
      <div class="mt-12">
        <LearnMoreSection mineral={mineral} />
      </div>
    </div>
  </main>
</BaseLayout>
