---
/**
 * Quiz hub page — SSG intro prose + Course/Quiz JSON-LD.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { QuizPage } from '../../components/quiz/QuizPage';
import type { LearnEntry } from '../../lib/quiz';

const learnEntries = await getCollection('learn');

const entries: LearnEntry[] = learnEntries.map(entry => ({
  id: entry.id,
  data: {
    title: entry.data.title,
    description: entry.data.description,
    category: entry.data.category,
    difficulty: entry.data.difficulty,
    sections: entry.data.sections,
  },
}));

const pageDescription =
  'Practice and exam-mode quizzes aligned with the FGA diploma curriculum, covering all eight gemmology topic areas with SM-2 spaced-repetition scheduling.';

const categories = [
  { name: 'Fundamentals', description: 'Crystal systems, optical properties, and physical properties.' },
  { name: 'Equipment', description: 'Refractometer, spectroscope, and polariscope techniques.' },
  { name: 'Species', description: 'Individual gemstone identification and characteristic properties.' },
  { name: 'Identification', description: 'Diagnostic procedures and systematic testing sequences.' },
  { name: 'Phenomena', description: 'Asterism, chatoyancy, colour change, adularescence, and related effects.' },
  { name: 'Origin', description: 'Geographic origin determination and provenance indicators.' },
  { name: 'Market & Grading', description: 'Grading standards, valuation principles, and treatment disclosure.' },
  { name: 'Care & Durability', description: 'Gem care, safe cleaning methods, and setting compatibility.' },
];

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Gemmology Practice Quiz',
  description: pageDescription,
  provider: {
    '@type': 'Organization',
    name: 'gemmology.dev',
    url: 'https://gemmology.dev',
  },
  educationalCredentialAwarded: 'FGA Diploma exam preparation',
  courseMode: ['online'],
  educationalLevel: 'Intermediate',
  isAccessibleForFree: true,
  inLanguage: 'en',
  hasCourseInstance: categories.map(cat => ({
    '@type': 'CourseInstance',
    courseMode: 'online',
    name: cat.name,
  })),
};

const quizSchema = {
  '@context': 'https://schema.org',
  '@type': 'Quiz',
  name: 'Gemmology Quiz Bank',
  about: {
    '@type': 'Thing',
    name: 'Gemmology',
  },
  educationalLevel: 'Intermediate',
  audience: {
    '@type': 'EducationalAudience',
    educationalRole: 'student',
  },
};
---

<BaseLayout title="Quiz" description={pageDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(quizSchema)} />
  </Fragment>

  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <header class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900">Gemmology Quiz</h1>
        <p class="text-slate-600 mt-2 text-lg">
          Test and consolidate your gemmology knowledge across all eight FGA-aligned topic areas.
        </p>
      </header>

      <section class="prose prose-slate max-w-none mb-10">
        <p>
          The gemmology quiz draws questions from a curated bank aligned with the
          <strong>FGA diploma curriculum</strong>. Questions span eight topic areas: Fundamentals
          (crystal systems, optical and physical properties), Equipment (refractometer,
          spectroscope, polariscope), Species (individual gem identification), Identification
          (diagnostic procedures and testing sequences), Phenomena (asterism, chatoyancy, colour
          change), Origin (geographic provenance indicators), Market &amp; Grading (standards,
          valuation, and treatments), and Care &amp; Durability (cleaning, setting compatibility).
          Each question links back to its source article in the Learn section so you can review the
          underlying theory immediately after answering.
        </p>

        <p>
          Two modes are available. <strong>Practice mode</strong> delivers immediate feedback after
          each answer, shows a rationale panel explaining why the correct answer is right and why
          each distractor is wrong, and optionally invites a confidence tap (Unsure / Fairly sure /
          Certain) before revealing the result. <strong>Exam mode</strong> simulates a timed
          assessment with configurable durations (15 to 90 minutes), no in-question feedback, a
          navigation grid for flagging questions, and a detailed results breakdown at the end
          including per-category scores, letter grade, and pass/fail at the 70&nbsp;% FGA threshold.
        </p>

        <p>
          The quiz engine uses <strong>SM-2 spaced-repetition scheduling</strong>. Every answer
          updates an interval and ease factor for that question; due items are prioritised at the
          start of each new session, ensuring you spend revision time on material you are most
          likely to forget rather than questions already committed to long-term memory. A
          &ldquo;Review Now&rdquo; shortcut on the study dashboard surfaces all currently due
          items with no setup screen, making it easy to fit a focused five-minute review into any
          break between study sessions.
        </p>

        <h2 class="text-xl font-semibold text-slate-800 mt-8 mb-3">Quiz categories</h2>
        <ul class="space-y-1">
          {categories.map(cat => (
            <li class="text-slate-700">
              <strong>{cat.name}:</strong> {cat.description}
            </li>
          ))}
        </ul>
      </section>

      <QuizPage client:load learnEntries={entries} />

    </div>
  </div>
</BaseLayout>
