---
/**
 * 404 Not Found Page
 * Provides helpful navigation when users land on non-existent pages
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { Container, Button, Card } from '../components/ui-astro';
import { getSiteStats } from '../lib/stats';

const { familyCount } = await getSiteStats();

const popularPages = [
  { title: 'Crystal Gallery', href: '/gallery', description: `Explore ${familyCount} mineral crystal structures` },
  { title: 'Learn Gemmology', href: '/learn', description: 'FGA curriculum and educational content' },
  { title: 'Quiz', href: '/quiz', description: 'Practice and exam-mode questions across the FGA syllabus' },
  { title: 'Documentation', href: '/docs', description: 'API reference and guides' },
];
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <Container size="md" padding="lg" class="min-h-[60vh] flex flex-col items-center justify-center text-center">
    <div class="relative mb-8" aria-hidden="true">
      <svg class="w-32 h-32 text-crystal-200" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.5">
        <polygon points="100,30 160,80 130,160 70,160 40,80" fill="currentColor" fill-opacity="0.18"/>
        <polygon points="100,30 160,80 130,160 70,160 40,80"/>
        <line x1="100" y1="30" x2="100" y2="160" stroke-opacity="0.4"/>
        <line x1="40" y1="80" x2="160" y2="80" stroke-opacity="0.4"/>
        <line x1="70" y1="160" x2="160" y2="80" stroke-opacity="0.3"/>
        <line x1="130" y1="160" x2="40" y2="80" stroke-opacity="0.3"/>
      </svg>
      <span class="absolute inset-0 flex items-center justify-center text-4xl font-bold text-slate-700">404</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-semibold text-slate-900 mb-3">Lost in the lattice</h1>
    <p class="text-slate-600 mb-8 max-w-md">
      This page doesn&apos;t crystallise. The URL you followed doesn&apos;t correspond to a known structure &mdash; it may have been moved or never existed.
    </p>

    <div class="flex flex-wrap justify-center gap-4 mb-12">
      <Button href="/" variant="primary">Return to homepage</Button>
      <Button href="/gallery" variant="secondary">Browse Gallery</Button>
      <Button href="/learn" variant="ghost">Open Learn</Button>
    </div>

    <div class="w-full max-w-2xl">
      <h2 class="text-lg font-semibold text-slate-900 mb-4">Popular Pages</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {popularPages.map(page => (
          <Card href={page.href} hover padding="md">
            <h3 class="font-medium text-slate-900">{page.title}</h3>
            <p class="text-sm text-slate-600 mt-1">{page.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </Container>
</BaseLayout>
