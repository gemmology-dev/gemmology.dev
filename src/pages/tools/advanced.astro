---
/**
 * Advanced Analysis tools page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdvancedTools } from '../../components/advanced/AdvancedTools';
---

<BaseLayout
  title="Advanced Analysis"
  description="Treatment detection, origin determination, and gemstone proportion analysis tools."
>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white py-12">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900">Advanced Analysis</h1>
        <p class="text-slate-600 mt-2">
          Advanced gemmological analysis tools including treatment detection reference, origin determination characteristics, and gemstone cut proportion analyzer.
        </p>
      </div>
      <AdvancedTools client:load />
    </div>
  </div>
</BaseLayout>
