---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Gallery } from '../../components/gallery/Gallery';
import { Container, SectionHeader } from '../../components/ui';
import { getSiteStats } from '../../lib/stats';

const url = Astro.url;
const initialSystem = url.searchParams.get('system') || '';
const initialSearch = url.searchParams.get('search') || '';
const initialOrigin = url.searchParams.get('origin') || '';

// Always point to base gallery URL as canonical to prevent duplicate content from filters
const canonicalURL = 'https://gemmology.dev/gallery';

const { familyCount } = await getSiteStats();
---

<BaseLayout
  title="Crystal Gallery"
  description={`Explore ${familyCount} mineral families with FGA-accurate crystallographic data and interactive visualizations.`}
  canonical={canonicalURL}
>
  <div class="bg-gradient-to-b from-crystal-50 to-white min-h-[80vh]">
    <Container size="xl" padding="md">
      <SectionHeader
        title="Crystal Gallery"
        description={`Explore ${familyCount} mineral families with FGA-accurate crystallographic data. Click any crystal to view detailed properties and open in the playground.`}
      />
      <Gallery
        client:load
        initialSystem={initialSystem}
        initialSearch={initialSearch}
        initialOrigin={initialOrigin}
      />
    </Container>
  </div>
</BaseLayout>
