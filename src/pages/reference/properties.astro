---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { IconBox } from '../../components/ui/IconBox';
import { Container } from '../../components/ui/Container';
import { Breadcrumb } from '../../components/docs';

interface GemRow {
  name: string;
  species: string;
  formula: string;
  system: 'Cubic' | 'Tetragonal' | 'Hexagonal' | 'Trigonal' | 'Orthorhombic' | 'Monoclinic' | 'Triclinic' | 'Amorphous';
  ri: string;
  birefringence: string;
  sg: string;
  hardness: string;
  cleavage: string;
}

// 50 of the most-queried gemstones for a properties chart, in alphabetical order.
// Values are drawn from Webster's Gems (Reade, 7th ed.), Read's Gemmology (3rd ed.),
// O'Donoghue's Gems (6th ed.), Schumann's Gemstones of the World, and the LMHC
// terminology guide. Ranges are stated where the species shows compositional variation.
const gems: GemRow[] = [
  { name: 'Agate', species: 'Quartz (chalcedony)', formula: 'SiO₂', system: 'Trigonal', ri: '1.535–1.539', birefringence: '0.004 (aggregate)', sg: '2.58–2.64', hardness: '6.5–7', cleavage: 'None' },
  { name: 'Alexandrite', species: 'Chrysoberyl', formula: 'BeAl₂O₄', system: 'Orthorhombic', ri: '1.745–1.755', birefringence: '0.008–0.010', sg: '3.70–3.73', hardness: '8.5', cleavage: 'Distinct (1 direction)' },
  { name: 'Almandine garnet', species: 'Garnet', formula: 'Fe₃Al₂(SiO₄)₃', system: 'Cubic', ri: '1.770–1.830', birefringence: 'None', sg: '3.95–4.30', hardness: '7–7.5', cleavage: 'None' },
  { name: 'Amazonite', species: 'Feldspar (microcline)', formula: 'KAlSi₃O₈', system: 'Triclinic', ri: '1.522–1.530', birefringence: '0.008', sg: '2.56–2.58', hardness: '6–6.5', cleavage: 'Perfect (2 directions)' },
  { name: 'Amber', species: 'Fossil resin', formula: 'C₁₀H₁₆O', system: 'Amorphous', ri: '1.539–1.545', birefringence: 'None', sg: '1.05–1.10', hardness: '2–2.5', cleavage: 'None' },
  { name: 'Amethyst', species: 'Quartz', formula: 'SiO₂', system: 'Trigonal', ri: '1.544–1.553', birefringence: '0.009', sg: '2.65', hardness: '7', cleavage: 'None' },
  { name: 'Andalusite', species: 'Andalusite', formula: 'Al₂SiO₅', system: 'Orthorhombic', ri: '1.634–1.643', birefringence: '0.007–0.013', sg: '3.12–3.18', hardness: '7–7.5', cleavage: 'Distinct (1 direction)' },
  { name: 'Apatite', species: 'Apatite', formula: 'Ca₅(PO₄)₃(F,Cl,OH)', system: 'Hexagonal', ri: '1.628–1.649', birefringence: '0.002–0.013', sg: '3.16–3.23', hardness: '5', cleavage: 'Indistinct' },
  { name: 'Aquamarine', species: 'Beryl', formula: 'Be₃Al₂Si₆O₁₈', system: 'Hexagonal', ri: '1.564–1.596', birefringence: '0.005–0.009', sg: '2.68–2.91', hardness: '7.5–8', cleavage: 'Indistinct' },
  { name: 'Aventurine', species: 'Quartz', formula: 'SiO₂', system: 'Trigonal', ri: '1.544–1.553', birefringence: '0.009 (aggregate)', sg: '2.64–2.69', hardness: '7', cleavage: 'None' },
  { name: 'Beryl (heliodor)', species: 'Beryl', formula: 'Be₃Al₂Si₆O₁₈', system: 'Hexagonal', ri: '1.566–1.591', birefringence: '0.005–0.008', sg: '2.66–2.83', hardness: '7.5–8', cleavage: 'Indistinct' },
  { name: 'Carnelian', species: 'Quartz (chalcedony)', formula: 'SiO₂', system: 'Trigonal', ri: '1.535–1.539', birefringence: '0.004 (aggregate)', sg: '2.58–2.64', hardness: '6.5–7', cleavage: 'None' },
  { name: 'Chrysoberyl', species: 'Chrysoberyl', formula: 'BeAl₂O₄', system: 'Orthorhombic', ri: '1.746–1.755', birefringence: '0.008–0.011', sg: '3.71–3.75', hardness: '8.5', cleavage: 'Distinct (1 direction)' },
  { name: 'Chrysoprase', species: 'Quartz (chalcedony)', formula: 'SiO₂', system: 'Trigonal', ri: '1.535–1.539', birefringence: '0.004 (aggregate)', sg: '2.58–2.64', hardness: '6.5–7', cleavage: 'None' },
  { name: 'Citrine', species: 'Quartz', formula: 'SiO₂', system: 'Trigonal', ri: '1.544–1.553', birefringence: '0.009', sg: '2.65', hardness: '7', cleavage: 'None' },
  { name: 'Coral (precious)', species: 'Calcium carbonate', formula: 'CaCO₃', system: 'Trigonal', ri: '1.486–1.658', birefringence: '0.160 (aggregate)', sg: '2.60–2.70', hardness: '3–4', cleavage: 'None' },
  { name: 'Demantoid garnet', species: 'Garnet (andradite)', formula: 'Ca₃Fe₂(SiO₄)₃', system: 'Cubic', ri: '1.880–1.889', birefringence: 'None', sg: '3.82–3.85', hardness: '6.5–7', cleavage: 'None' },
  { name: 'Diamond', species: 'Diamond', formula: 'C', system: 'Cubic', ri: '2.417', birefringence: 'None', sg: '3.51–3.53', hardness: '10', cleavage: 'Perfect (4 directions)' },
  { name: 'Diopside', species: 'Pyroxene', formula: 'CaMgSi₂O₆', system: 'Monoclinic', ri: '1.664–1.730', birefringence: '0.024–0.030', sg: '3.22–3.40', hardness: '5–6', cleavage: 'Good (2 directions)' },
  { name: 'Emerald', species: 'Beryl', formula: 'Be₃Al₂Si₆O₁₈', system: 'Hexagonal', ri: '1.570–1.590', birefringence: '0.005–0.009', sg: '2.67–2.78', hardness: '7.5–8', cleavage: 'Indistinct' },
  { name: 'Fluorite', species: 'Fluorite', formula: 'CaF₂', system: 'Cubic', ri: '1.433–1.435', birefringence: 'None', sg: '3.18', hardness: '4', cleavage: 'Perfect (4 directions)' },
  { name: 'Hessonite garnet', species: 'Garnet (grossular)', formula: 'Ca₃Al₂(SiO₄)₃', system: 'Cubic', ri: '1.736–1.745', birefringence: 'None', sg: '3.60–3.68', hardness: '7–7.5', cleavage: 'None' },
  { name: 'Iolite', species: 'Cordierite', formula: '(Mg,Fe)₂Al₃[AlSi₅O₁₈]', system: 'Orthorhombic', ri: '1.522–1.578', birefringence: '0.008–0.012', sg: '2.57–2.66', hardness: '7–7.5', cleavage: 'Distinct (1 direction)' },
  { name: 'Jadeite', species: 'Pyroxene', formula: 'NaAlSi₂O₆', system: 'Monoclinic', ri: '1.652–1.688', birefringence: '0.012 (aggregate)', sg: '3.30–3.38', hardness: '6.5–7', cleavage: 'Good (none in aggregate)' },
  { name: 'Kunzite', species: 'Spodumene', formula: 'LiAlSi₂O₆', system: 'Monoclinic', ri: '1.660–1.681', birefringence: '0.014–0.016', sg: '3.15–3.21', hardness: '6.5–7', cleavage: 'Perfect (2 directions)' },
  { name: 'Labradorite', species: 'Feldspar', formula: '(Ca,Na)(Al,Si)₄O₈', system: 'Triclinic', ri: '1.559–1.572', birefringence: '0.008–0.010', sg: '2.69–2.72', hardness: '6–6.5', cleavage: 'Perfect (2 directions)' },
  { name: 'Lapis lazuli', species: 'Rock (lazurite + others)', formula: '(Na,Ca)₈(Al,Si)₁₂O₂₄(S,SO₄)', system: 'Cubic (aggregate)', ri: '1.50 (mean)', birefringence: 'None (aggregate)', sg: '2.50–3.00', hardness: '5–6', cleavage: 'None' },
  { name: 'Malachite', species: 'Malachite', formula: 'Cu₂CO₃(OH)₂', system: 'Monoclinic', ri: '1.655–1.909', birefringence: '0.254 (aggregate)', sg: '3.95–4.10', hardness: '3.5–4', cleavage: 'Perfect (aggregate)' },
  { name: 'Moonstone', species: 'Feldspar (orthoclase)', formula: 'KAlSi₃O₈', system: 'Monoclinic', ri: '1.518–1.526', birefringence: '0.005–0.008', sg: '2.56–2.59', hardness: '6–6.5', cleavage: 'Perfect (2 directions)' },
  { name: 'Morganite', species: 'Beryl', formula: 'Be₃Al₂Si₆O₁₈', system: 'Hexagonal', ri: '1.585–1.594', birefringence: '0.008–0.009', sg: '2.71–2.90', hardness: '7.5–8', cleavage: 'Indistinct' },
  { name: 'Opal (precious)', species: 'Hydrated silica', formula: 'SiO₂·nH₂O', system: 'Amorphous', ri: '1.37–1.47', birefringence: 'None', sg: '1.98–2.25', hardness: '5.5–6.5', cleavage: 'None' },
  { name: 'Pearl', species: 'Aragonite (organic)', formula: 'CaCO₃', system: 'Orthorhombic (aggregate)', ri: '1.530–1.685', birefringence: '0.155 (aggregate)', sg: '2.66–2.78', hardness: '2.5–4', cleavage: 'None' },
  { name: 'Peridot', species: 'Olivine (forsterite)', formula: '(Mg,Fe)₂SiO₄', system: 'Orthorhombic', ri: '1.654–1.690', birefringence: '0.033–0.038', sg: '3.27–3.48', hardness: '6.5–7', cleavage: 'Indistinct' },
  { name: 'Pyrope garnet', species: 'Garnet', formula: 'Mg₃Al₂(SiO₄)₃', system: 'Cubic', ri: '1.714–1.760', birefringence: 'None', sg: '3.65–3.87', hardness: '7–7.5', cleavage: 'None' },
  { name: 'Quartz (rock crystal)', species: 'Quartz', formula: 'SiO₂', system: 'Trigonal', ri: '1.544–1.553', birefringence: '0.009', sg: '2.65', hardness: '7', cleavage: 'None' },
  { name: 'Rhodochrosite', species: 'Rhodochrosite', formula: 'MnCO₃', system: 'Trigonal', ri: '1.578–1.840', birefringence: '0.201–0.220', sg: '3.45–3.70', hardness: '3.5–4', cleavage: 'Perfect (3 directions)' },
  { name: 'Rhodolite garnet', species: 'Garnet (pyrope-almandine)', formula: '(Mg,Fe)₃Al₂(SiO₄)₃', system: 'Cubic', ri: '1.745–1.760', birefringence: 'None', sg: '3.74–3.94', hardness: '7–7.5', cleavage: 'None' },
  { name: 'Rhodonite', species: 'Rhodonite', formula: 'MnSiO₃', system: 'Triclinic', ri: '1.711–1.751', birefringence: '0.011–0.014', sg: '3.40–3.74', hardness: '5.5–6.5', cleavage: 'Perfect (2 directions)' },
  { name: 'Ruby', species: 'Corundum', formula: 'Al₂O₃', system: 'Trigonal', ri: '1.762–1.770', birefringence: '0.008–0.009', sg: '3.99–4.05', hardness: '9', cleavage: 'None (parting)' },
  { name: 'Sapphire (blue)', species: 'Corundum', formula: 'Al₂O₃', system: 'Trigonal', ri: '1.762–1.770', birefringence: '0.008–0.009', sg: '3.95–4.03', hardness: '9', cleavage: 'None (parting)' },
  { name: 'Sphene (titanite)', species: 'Titanite', formula: 'CaTiSiO₅', system: 'Monoclinic', ri: '1.900–2.034', birefringence: '0.105–0.135', sg: '3.45–3.55', hardness: '5–5.5', cleavage: 'Distinct (1 direction)' },
  { name: 'Spinel', species: 'Spinel', formula: 'MgAl₂O₄', system: 'Cubic', ri: '1.712–1.736', birefringence: 'None', sg: '3.58–3.61', hardness: '8', cleavage: 'None' },
  { name: 'Spodumene (hiddenite)', species: 'Spodumene', formula: 'LiAlSi₂O₆', system: 'Monoclinic', ri: '1.660–1.681', birefringence: '0.014–0.016', sg: '3.16–3.20', hardness: '6.5–7', cleavage: 'Perfect (2 directions)' },
  { name: 'Sunstone', species: 'Feldspar (oligoclase)', formula: '(Na,Ca)(Al,Si)₄O₈', system: 'Triclinic', ri: '1.537–1.547', birefringence: '0.007–0.010', sg: '2.64–2.66', hardness: '6–6.5', cleavage: 'Perfect (2 directions)' },
  { name: 'Tanzanite', species: 'Zoisite', formula: 'Ca₂Al₃(SiO₄)₃(OH)', system: 'Orthorhombic', ri: '1.691–1.700', birefringence: '0.009', sg: '3.10–3.38', hardness: '6–7', cleavage: 'Perfect (1 direction)' },
  { name: 'Topaz', species: 'Topaz', formula: 'Al₂SiO₄(F,OH)₂', system: 'Orthorhombic', ri: '1.609–1.638', birefringence: '0.008–0.011', sg: '3.49–3.57', hardness: '8', cleavage: 'Perfect (1 direction)' },
  { name: 'Tourmaline (elbaite)', species: 'Tourmaline', formula: 'Na(Li,Al)₃Al₆(BO₃)₃Si₆O₁₈(OH)₄', system: 'Trigonal', ri: '1.624–1.644', birefringence: '0.014–0.024', sg: '3.00–3.10', hardness: '7–7.5', cleavage: 'None' },
  { name: 'Tsavorite garnet', species: 'Garnet (grossular)', formula: 'Ca₃Al₂(SiO₄)₃', system: 'Cubic', ri: '1.734–1.760', birefringence: 'None', sg: '3.60–3.68', hardness: '7–7.5', cleavage: 'None' },
  { name: 'Turquoise', species: 'Turquoise', formula: 'CuAl₆(PO₄)₄(OH)₈·4H₂O', system: 'Triclinic', ri: '1.610–1.650 (mean 1.62)', birefringence: '0.040 (aggregate)', sg: '2.60–2.85', hardness: '5–6', cleavage: 'None' },
  { name: 'Zircon (high)', species: 'Zircon', formula: 'ZrSiO₄', system: 'Tetragonal', ri: '1.925–1.984', birefringence: '0.058–0.059', sg: '4.60–4.80', hardness: '7.5', cleavage: 'Indistinct' },
