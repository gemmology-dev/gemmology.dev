const properties = ['Refractive index', 'Specific gravity', 'Mohs hardness', 'Birefringence', 'Crystal system', 'Cleavage'];

const tableJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Gemstone Properties Reference Chart',
  description:
    'Refractive index, specific gravity, Mohs hardness, birefringence, crystal system, and cleavage for 50 commonly encountered gemstones, drawn from standard FGA-curriculum references.',
  url: 'https://gemmology.dev/reference/properties/',
  keywords: [
    'gemstone properties chart',
    'gem refractive index table',
    'specific gravity gems',
    'Mohs hardness gemstones',
    'birefringence gems',
  ],
  creator: {
    '@type': 'Organization',
    name: 'gemmology.dev',
    url: 'https://gemmology.dev',
  },
  license: 'https://creativecommons.org/licenses/by-sa/4.0/',
  isAccessibleForFree: true,
  variableMeasured: properties,
};

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Gemstone Properties Chart',
  url: 'https://gemmology.dev/reference/properties/',
  description:
    'Free reference table of refractive index, specific gravity, Mohs hardness, birefringence, crystal system, and cleavage for 50 commonly encountered gemstones.',
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'gemmology.dev',
    url: 'https://gemmology.dev',
  },
  primaryImageOfPage: undefined,
  mainEntity: {
    '@type': 'Table',
    about: 'Gemstone optical and physical properties',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://gemmology.dev' },
    { '@type': 'ListItem', position: 2, name: 'Reference', item: 'https://gemmology.dev/reference/properties/' },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Gemstone properties chart',
      item: 'https://gemmology.dev/reference/properties/',
    },
  ],
};

const breadcrumbItems = [{ label: 'Reference' }, { label: 'Gemstone properties chart' }];
---

<BaseLayout
  title="Gemstone Properties Chart — RI, SG, Hardness, Birefringence (50 gems)"
  description="Free reference chart of 50 gemstones with refractive index, specific gravity, Mohs hardness, birefringence, crystal system, and cleavage. FGA curriculum data sourced from Webster, Read, O'Donoghue, and Schumann."
>
  <script type="application/ld+json" set:html={JSON.stringify(tableJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <div class="bg-gradient-to-b from-crystal-50 to-white dark:from-coffee-page dark:to-coffee-page min-h-screen">
    <Container size="xl" padding="md">
      <Breadcrumb items={breadcrumbItems} />

      <header class="max-w-3xl pb-8 mt-4 border-b border-slate-200 dark:border-coffee-border">
        <h1 class="text-4xl font-bold text-slate-900 dark:text-cream-primary">Gemstone properties chart</h1>
        <p class="mt-3 text-lg font-medium text-crystal-700 dark:text-crystal-300">
          50 commonly encountered gems: RI, SG, hardness, birefringence, crystal system, cleavage
        </p>
        <p class="mt-5 text-base text-slate-700 dark:text-cream-secondary leading-relaxed">
          A single-page reference table of the six diagnostic gemmological constants (refractive
          index, specific gravity, Mohs hardness, birefringence, crystal system, and cleavage) for
          50 of the most commonly encountered gemstones in commercial and FGA-curriculum practice.
          Values are stated as Webster and Read report them, with ranges where compositional
          variation is significant (e.g. tourmaline 1.624–1.644 reflecting elbaite chemistry).
          Cabochon and aggregate readings are flagged separately because the refractometer reports
          a spot reading rather than a birefringence in those cases. For interactive lookup against
          your own measured values, try the
          <a href="/tools/measurement/" class="text-crystal-700 underline underline-offset-2 decoration-crystal-300 hover:decoration-crystal-700 dark:text-crystal-400 dark:decoration-crystal-400/30 dark:hover:text-crystal-300 dark:hover:decoration-gold">RI calculator</a>
          or the <a href="/tools/identification/" class="text-crystal-700 underline underline-offset-2 decoration-crystal-300 hover:decoration-crystal-700 dark:text-crystal-400 dark:decoration-crystal-400/30 dark:hover:text-crystal-300 dark:hover:decoration-gold">Gem Identifier</a>,
          both of which run entirely in your browser. For deeper coverage of each species and full
          mineralogical context, follow the species links on the
          <a href="/minerals/" class="text-crystal-700 underline underline-offset-2 decoration-crystal-300 hover:decoration-crystal-700 dark:text-crystal-400 dark:decoration-crystal-400/30 dark:hover:text-crystal-300 dark:hover:decoration-gold">Mineral Database</a>
          (159 expressions across 121 families). See the source-citation note below the table for
          our data lineage.
        </p>
      </header>

      <!-- 50-row properties table — table-rich result eligibility -->
      <section class="mt-10">
        <div class="flex items-center gap-3 mb-5">
          <IconBox variant="crystal" size="sm" className="shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 10h18M3 6h18M3 14h18M3 18h18"
              />
            </svg>
          </IconBox>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-cream-primary">Reference table: 50 gemstones</h2>
        </div>
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-coffee-border dark:bg-coffee-raised">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-50 text-slate-700 sticky top-0 dark:bg-coffee-raised2 dark:text-cream-primary">
              <tr>
                <th class="px-3 py-3 text-left font-semibold whitespace-nowrap">Name</th>
                <th class="px-3 py-3 text-left font-semibold">Species</th>
                <th class="px-3 py-3 text-left font-semibold">Formula</th>
                <th class="px-3 py-3 text-left font-semibold whitespace-nowrap">Crystal system</th>
                <th class="px-3 py-3 text-left font-semibold whitespace-nowrap">RI</th>
                <th class="px-3 py-3 text-left font-semibold whitespace-nowrap">Birefringence</th>
                <th class="px-3 py-3 text-left font-semibold whitespace-nowrap">SG</th>
                <th class="px-3 py-3 text-left font-semibold whitespace-nowrap">Hardness</th>
                <th class="px-3 py-3 text-left font-semibold">Cleavage</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-coffee-border">
              {gems.map((g) => (
                <tr class="hover:bg-slate-50 dark:hover:bg-coffee-raised2">
                  <td class="px-3 py-2.5 font-semibold text-slate-900 whitespace-nowrap dark:text-cream-primary">{g.name}</td>
                  <td class="px-3 py-2.5 text-slate-700 whitespace-nowrap dark:text-cream-secondary">{g.species}</td>
                  <td class="px-3 py-2.5 text-slate-600 font-mono text-xs dark:text-cream-muted">{g.formula}</td>
                  <td class="px-3 py-2.5 text-slate-700 whitespace-nowrap dark:text-cream-secondary">{g.system}</td>
                  <td class="px-3 py-2.5 text-slate-700 whitespace-nowrap font-mono text-xs dark:text-cream-secondary">{g.ri}</td>
                  <td class="px-3 py-2.5 text-slate-700 whitespace-nowrap font-mono text-xs dark:text-cream-secondary">{g.birefringence}</td>
                  <td class="px-3 py-2.5 text-slate-700 whitespace-nowrap font-mono text-xs dark:text-cream-secondary">{g.sg}</td>
                  <td class="px-3 py-2.5 text-slate-700 whitespace-nowrap font-mono text-xs dark:text-cream-secondary">{g.hardness}</td>
                  <td class="px-3 py-2.5 text-slate-700 dark:text-cream-secondary">{g.cleavage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-sm text-slate-500 dark:text-cream-muted">
          Showing {gems.length} gemstones. Hardness is on the Mohs scale; SG is dimensionless
          (water = 1.000 at 4 °C); RI is reported under sodium light (589 nm).
        </p>
      </section>

      <section class="mt-12">
        <div class="rounded-2xl bg-slate-50 border border-slate-200 p-6 sm:p-8 dark:bg-coffee-raised dark:border-coffee-border">
          <h2 class="text-xl font-semibold text-slate-900 dark:text-cream-primary">How to use this table</h2>
          <ol class="mt-4 list-decimal pl-6 space-y-2 text-slate-700 dark:text-cream-secondary">
            <li>
              <strong>Identify by RI first.</strong> Measure the unknown stone on a refractometer
              (sodium light, contact fluid n=1.81). The midpoint reading locates a row band in this
              table to roughly ±0.005.
            </li>
            <li>
              <strong>Distinguish by birefringence.</strong> Rotate the stone through 180°. A
              singly-refractive stone matches an isotropic row ("None"); a doubly-refractive stone
              gives a birefringence value that further narrows the candidates.
            </li>
            <li>
              <strong>Confirm with SG.</strong> Hydrostatic weighing or heavy liquids resolves
              ambiguities between species with overlapping RI (e.g. emerald 2.67–2.78 vs aquamarine
              2.68–2.91, which are closely overlapping; hessonite 3.60–3.68 vs tsavorite 3.60–3.68
              needs colour and inclusion analysis).
            </li>
            <li>
              <strong>Check cleavage for cutting / care.</strong> Topaz (perfect 1-direction),
              diamond (perfect 4-direction), and spodumene (perfect 2-direction) require careful
              setting and avoid ultrasonic cleaning.
            </li>
          </ol>
