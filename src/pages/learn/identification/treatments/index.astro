---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { Card, CardTitle, CardDescription } from '../../../../components/ui/Card';
import { IconBox } from '../../../../components/ui/IconBox';
import { Container } from '../../../../components/ui/Container';
import { DifficultyBadge } from '../../../../components/ui/DifficultyBadge';
import { Breadcrumb } from '../../../../components/docs';

const learnEntries = await getCollection('learn');

interface Topic {
  id: string;
  title: string;
  description: string;
  href: string;
  difficulty?: 'beginner' | 'intermediate' | 'advanced';
}

const idEntries: Topic[] = learnEntries
  .filter((e) => e.data.category === 'identification')
  .map((e) => ({
    id: e.id,
    title: e.data.title,
    description: e.data.description,
    href: `/learn/${e.id}`,
    difficulty: e.data.difficulty as Topic['difficulty'],
  }));

const treatmentDeepDives = idEntries
  .filter((t) => t.id.startsWith('identification/treatments-deep/'))
  .sort((a, b) => a.title.localeCompare(b.title));

const directTreatmentArticles = idEntries.filter(
  (t) => t.id === 'identification/treatments' ||
         t.id === 'identification/synthetics' ||
         t.id === 'identification/composite-stones'
);

const learningResourceSchema = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: 'Synthetic Diamond Identification, Treatments &amp; Composite Stones',
  alternateName: [
    'Synthetic Diamond Identification',
    'Gemstone Treatment Detection',
    'Treatments and Synthetics Guide',
  ],
  description:
    'How to detect heat treatment, lattice diffusion, fissure filling, HPHT and CVD synthetic diamonds, flame-fusion / flux / hydrothermal corundum and beryl, lead-glass-filled ruby, and composite (doublet / triplet) stones.',
  url: 'https://gemmology.dev/learn/identification/treatments/',
  learningResourceType: 'Guide',
  educationalLevel: 'advanced',
  inLanguage: 'en',
  isAccessibleForFree: true,
  audience: {
    '@type': 'EducationalAudience',
    educationalRole: 'student',
  },
  about: [
    'Synthetic diamond identification',
    'HPHT diamond detection',
    'CVD diamond detection',
    'Heat treatment detection',
    'Beryllium lattice diffusion',
    'Lead-glass-filled ruby',
    'Flux and hydrothermal synthetics',
    'Composite stones (doublets, triplets)',
  ],
  teaches: [
    'Identifying HPHT-treated and HPHT-grown diamonds',
    'Distinguishing CVD synthetic diamond from natural via short-wave UV fluorescence and PL',
    'Detecting beryllium-diffused corundum colour zoning',
    'Recognising lead-glass filling in ruby under darkfield illumination',
    'Spotting flux fingerprints, gas bubbles, and curved striae in synthetic corundum and emerald',
    'Identifying garnet-topped doublets, opal triplets, and other assembled stones',
  ],
  hasPart: [...directTreatmentArticles, ...treatmentDeepDives].map((t) => ({
    '@type': 'LearningResource',
    name: t.title,
    url: `https://gemmology.dev${t.href}/`,
    learningResourceType: 'Article',
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://gemmology.dev' },
    { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://gemmology.dev/learn/' },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Identification',
      item: 'https://gemmology.dev/learn/identification/',
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: 'Treatments &amp; Synthetics',
      item: 'https://gemmology.dev/learn/identification/treatments/',
    },
  ],
};

const breadcrumbItems = [
  { label: 'Learn', href: '/learn' },
  { label: 'Identification', href: '/learn/identification' },
  { label: 'Treatments & Synthetics' },
];

interface DetectionRow {
  material: string;
  primaryTest: string;
  diagnostic: string;
  confidence: string;
}

const detectionRows: DetectionRow[] = [
  {
    material: 'HPHT synthetic diamond',
    primaryTest: 'DiamondView short-wave UV imaging',
    diagnostic: 'Yellow / green-blue cross-shaped fluorescence pattern along {100} growth sectors',
    confidence: 'High (lab-only)',
  },
  {
    material: 'CVD synthetic diamond',
    primaryTest: 'Photoluminescence (PL) at liquid-N₂ temperature',
    diagnostic: 'Si-V centre at 737 nm doublet; Ni and N-related defect pattern differing from natural',
    confidence: 'High (lab-only)',
  },
  {
    material: 'HPHT-treated natural diamond',
    primaryTest: 'PL + UV-Vis-NIR; sometimes microscopy',
    diagnostic: 'Removed brown colour from Type IIa; reduced 415 nm Cape line; stress-related graining',
    confidence: 'High (lab-only)',
  },
  {
    material: 'Heat-treated ruby / sapphire',
    primaryTest: 'Microscopy (10–40×) for altered inclusions',
    diagnostic: 'Discoid stress fractures, melted / re-crystallised silk, partially-dissolved rutile',
    confidence: 'High (gemmologist)',
  },
  {
    material: 'Beryllium-diffused sapphire',
    primaryTest: 'LIBS or LA-ICP-MS for Be at >5 ppm',
    diagnostic: 'Padparadscha-style orange-pink colour rim; concentric colour zoning under microscope',
    confidence: 'Definitive (lab-only)',
  },
  {
    material: 'Lead-glass-filled ruby',
    primaryTest: 'Darkfield microscopy + reflected light',
    diagnostic: 'Blue / orange flash effect at fracture interfaces; trapped gas bubbles; lower lustre patches',
    confidence: 'High (gemmologist)',
  },
  {
    material: 'Flux-grown synthetic corundum (Chatham, Kashan, Knischka)',
    primaryTest: 'Microscopy',
    diagnostic: 'Flux fingerprints (twisted veils), platinum platelets, hexagonal growth zoning',
    confidence: 'High (gemmologist)',
  },
  {
    material: 'Flame-fusion (Verneuil) corundum / spinel',
    primaryTest: 'Microscopy + polariscope',
    diagnostic: 'Curved colour bands; gas bubbles in clouds; tabular elongation pattern',
    confidence: 'Definitive (gemmologist)',
  },
  {
    material: 'Hydrothermal synthetic emerald (Biron, Lechleitner, Tairus)',
    primaryTest: 'Microscopy + RI',
    diagnostic: 'Chevron growth structure, two-phase nail-head inclusions, slightly lower RI than natural',
    confidence: 'High (gemmologist)',
  },
  {
    material: 'Garnet-topped doublet',
    primaryTest: 'Microscopy (immersion in water)',
    diagnostic: 'Red reflection from garnet crown; cement plane with gas bubbles; girdle separation',
    confidence: 'Definitive (gemmologist)',
  },
  {
    material: 'Opal triplet',
    primaryTest: 'Side-view immersion microscopy',
    diagnostic: 'Three layers: black base, thin opal slice, transparent dome (quartz / glass)',
    confidence: 'Definitive (gemmologist)',
  },
];

const iconPaths: Record<string, string> = {
  fire:
    'M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z',
  beaker:
    'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  shield:
    'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
};
---

<BaseLayout
  title="Synthetic Diamond Identification, Treatments & Composite Stones — Free FGA Guide"
  description="How to identify HPHT and CVD synthetic diamond, heat-treated ruby and sapphire, beryllium-diffused corundum, lead-glass-filled ruby, flux and hydrothermal synthetics, and assembled stones. Free FGA-aligned reference."
>
  <script type="application/ld+json" set:html={JSON.stringify(learningResourceSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <div class="bg-gradient-to-b from-crystal-50 to-white dark:from-coffee-page dark:to-coffee-page min-h-screen">
    <Container size="lg" padding="md">
      <Breadcrumb items={breadcrumbItems} />

      <header class="max-w-3xl pb-8 mt-4 border-b border-slate-200 dark:border-coffee-border">
        <h1 class="text-4xl font-bold text-slate-900 dark:text-cream-primary">
          Synthetic diamond identification, treatments &amp; composite stones
        </h1>
        <p class="mt-3 text-lg font-medium text-crystal-700 dark:text-crystal-300">
          Free FGA-aligned treatments and synthetics reference
        </p>
        <p class="mt-5 text-base text-slate-700 dark:text-cream-secondary leading-relaxed">
          Modern lab-grown <strong>synthetic diamond</strong> (both HPHT, high-pressure /
          high-temperature, and CVD, chemical vapour deposition) is gemmologically identical to
          natural diamond by routine refractive index and specific gravity measurement, so
          identification depends on photoluminescence, short-wave UV fluorescence (DiamondView), and
          subtle defect-centre patterns visible only with laboratory instruments. The same is true
          for treated coloured stones: beryllium lattice diffusion, lead-glass fracture filling,
          flux-grown synthetic corundum, and hydrothermal synthetic emerald all require informed
          microscopy and, for the most ambiguous cases, FTIR / Raman / LA-ICP-MS analysis. This hub
          collects the {treatmentDeepDives.length + directTreatmentArticles.length} FGA-aligned
          articles on these topics, plus a one-page detection matrix covering the eleven highest-
          stakes materials a gemmologist encounters in commercial practice. Disclosure of treatment
          and synthetic origin is required by LMHC, GIA, and CIBJO standards, so confident
          identification is a commercial as well as an educational skill.
        </p>
      </header>

      <!-- Detection matrix — table-rich result eligibility -->
      <section class="mt-12">
        <div class="flex items-center gap-3 mb-5">
          <IconBox variant="ruby" size="sm" className="shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d={iconPaths.fire}
              />
            </svg>
          </IconBox>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-cream-primary">Eleven-material detection matrix</h2>
        </div>
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-coffee-border dark:bg-coffee-raised">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-50 text-slate-700 dark:bg-coffee-raised2 dark:text-cream-primary">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Material</th>
                <th class="px-4 py-3 text-left font-semibold">Primary test</th>
                <th class="px-4 py-3 text-left font-semibold">Diagnostic finding</th>
                <th class="px-4 py-3 text-left font-semibold">Confidence</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-coffee-border">
              {detectionRows.map((row) => (
                <tr>
                  <td class="px-4 py-3 font-medium text-slate-900 dark:text-cream-primary align-top">{row.material}</td>
                  <td class="px-4 py-3 text-slate-700 dark:text-cream-secondary align-top">{row.primaryTest}</td>
                  <td class="px-4 py-3 text-slate-700 dark:text-cream-secondary align-top">{row.diagnostic}</td>
                  <td class="px-4 py-3 text-slate-600 dark:text-cream-muted align-top">{row.confidence}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-sm text-slate-600 dark:text-cream-secondary">
          For evidence-weighted detection across multiple clues, try the
          <a href="/tools/advanced/" class="text-crystal-700 underline underline-offset-2 decoration-crystal-300 hover:decoration-crystal-700 dark:text-crystal-400 dark:decoration-crystal-400/30 dark:hover:text-crystal-300 dark:hover:decoration-gold">Treatment Wizard</a>
          (18 clues × 11 treatments, weighted scoring) and the
          <a href="/tools/advanced/" class="text-crystal-700 underline underline-offset-2 decoration-crystal-300 hover:decoration-crystal-700 dark:text-crystal-400 dark:decoration-crystal-400/30 dark:hover:text-crystal-300 dark:hover:decoration-gold">Treatment Detection table</a>.
        </p>
      </section>

      {treatmentDeepDives.length > 0 && (
        <section class="mt-14">
          <div class="flex items-center gap-3 mb-6">
            <IconBox variant="ruby" size="sm" className="shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d={iconPaths.beaker}
                />
              </svg>
            </IconBox>
            <h2 class="text-2xl font-bold text-slate-900 dark:text-cream-primary">Deep-dive treatment / synthetic articles</h2>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {treatmentDeepDives.map((t) => (
              <a href={t.href} class="group">
                <Card hover padding="md" className="h-full">
                  <CardTitle className="text-base leading-tight group-hover:text-crystal-700 transition-colors">
                    {t.title}
                  </CardTitle>
                  <CardDescription className="mt-1.5">{t.description}</CardDescription>
                  {t.difficulty && <DifficultyBadge level={t.difficulty} className="mt-3" />}
                </Card>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="mt-12">
        <div class="flex items-center gap-3 mb-6">
          <IconBox variant="amethyst" size="sm" className="shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d={iconPaths.shield}
              />
            </svg>
          </IconBox>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-cream-primary">Foundation overview articles</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {/* The flagship 'identification/treatments' article is intentionally
              omitted here because this hub page replaces its standalone route;
              its prose has been folded into the matrix and lead above. */}
          {directTreatmentArticles
            .filter((t) => t.id !== 'identification/treatments')
            .map((t) => (
              <a href={t.href} class="group">
                <Card hover padding="md" className="h-full">
                  <CardTitle className="text-base leading-tight group-hover:text-crystal-700 transition-colors">
                    {t.title}
                  </CardTitle>
                  <CardDescription className="mt-1.5">{t.description}</CardDescription>
                  {t.difficulty && <DifficultyBadge level={t.difficulty} className="mt-3" />}
                </Card>
              </a>
            ))}
        </div>
      </section>

      <section class="mt-16">
        <div class="rounded-2xl bg-slate-50 border border-slate-200 p-6 sm:p-8 dark:bg-coffee-raised dark:border-coffee-border">
          <h2 class="text-xl font-semibold text-slate-900 dark:text-cream-primary">Disclosure and lab reports</h2>
          <p class="mt-2 text-slate-700 dark:text-cream-secondary">
            Treatment and synthetic-origin disclosure is required practice across the trade. Major
            laboratories use harmonised terminology defined by the
            <a href="https://www.lmhc-gemmology.org/" target="_blank" rel="noopener noreferrer" class="text-crystal-700 underline underline-offset-2 decoration-crystal-300 hover:decoration-crystal-700 dark:text-crystal-400 dark:decoration-crystal-400/30 dark:hover:text-crystal-300 dark:hover:decoration-gold">Laboratory Manual Harmonisation Committee (LMHC)</a>:
          </p>
          <ul class="mt-4 list-disc pl-6 space-y-1.5 text-sm text-slate-700 dark:text-cream-secondary">
            <li>Treatments are reported with type, extent, and permanence on every coloured-stone report.</li>
            <li>Synthetic stones are labelled "synthetic" or "laboratory-grown"; the term "cultured" is reserved for pearls.</li>
            <li>Composite materials (doublets, triplets, lead-glass-filled ruby) must be sold under their composite identification, never as the parent species alone.</li>
            <li>See <a href="/learn/market/disclosure/" class="text-crystal-700 underline underline-offset-2 decoration-crystal-300 hover:decoration-crystal-700 dark:text-crystal-400 dark:decoration-crystal-400/30 dark:hover:text-crystal-300 dark:hover:decoration-gold">our disclosure article</a> for a full breakdown of trade-practice requirements by jurisdiction.</li>
          </ul>
        </div>
      </section>
    </Container>
  </div>
</BaseLayout>
